# Neon pooled connection string for the "nochalant" project.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Signs the session cookie. Use a long random string.
AUTH_SECRET=replace-with-openssl-rand-hex-32

# Public origin. Production: https://nochalant.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Owner account created by `npm run db:seed`.
SEED_ADMIN_EMAIL=fluxbeatempire@gmail.com
SEED_ADMIN_PASSWORD=choose-a-strong-password

# Google sign-in. Leave blank to keep the button visible but unconfigured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple. Leave blank until an Apple Services ID exists.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# bachs (default) or paystack. With no keys for the chosen provider, checkout stays in test mode.
PAYMENT_PROVIDER=bachs

# Bachs. Sandbox first: https://sandbox-api.bachs.io and an sk_sandbox_ key.
# Live is a key swap to sk_live_ (https://api.bachs.io). Leave the base unset unless you need to override it.
BACHS_API_KEY=
BACHS_API_BASE=
# Signing secret from the Bachs webhook endpoint. The previous secret is optional during a rotation.
BACHS_WEBHOOK_SECRET=
BACHS_WEBHOOK_SECRET_PREVIOUS=
# Optional. When unset, the app creates the NGN recurring products itself.
BACHS_PRODUCT_PRO_MONTHLY=
BACHS_PRODUCT_PRO_QUARTERLY=
BACHS_PRODUCT_PRO_YEARLY=

# Paystack. Used only when PAYMENT_PROVIDER=paystack.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# LiveKit. Without these, Speak uses the local microphone only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
