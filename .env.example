# Neon Managed Auth is accessed through the same-origin /api/auth proxy.
# Do not expose Neon Auth server configuration or database credentials as VITE_ variables.
#
# Preview-only server variables required for account features:
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
DATABASE_URL_POOLED=
# DATABASE_URL=  # Optional fallback if DATABASE_URL_POOLED is not supplied.
#
# Server-only HMAC secret for time-bound anonymous music play tickets (32+ random bytes)
PLAYBACK_TICKET_SECRET=
