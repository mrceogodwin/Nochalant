{
  "rewrites": [
    {
      "source": "/api/artists",
      "destination": "/api/community?type=artists"
    },
    {
      "source": "/api/community/faces",
      "destination": "/api/community?type=faces"
    },
    {
      "source": "/api/editorial/latest",
      "destination": "/api/admin/opinions?editorialLatestRoute=1"
    },
    {
      "source": "/api/health/database",
      "destination": "/api/health?database=1"
    },
    {
      "source": "/api/opinions/mine",
      "destination": "/api/opinions?mine=1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/content?type=sitemap"
    },
    {
      "source": "/story/:slug",
      "destination": "/api/content?type=story&slug=:slug"
    },
    {
      "source": "/api/editorial/auto-post",
      "destination": "/api/admin/opinions?editorialAutoPostRoute=1"
    },
    {
      "source": "/api/social",
      "destination": "/api/admin/opinions?socialRoute=1"
    },
    {
      "source": "/api/social/feed",
      "destination": "/api/admin/opinions?socialFeedRoute=1"
    },
    {
      "source": "/api/social/settings",
      "destination": "/api/admin/opinions?socialSettingsRoute=1"
    },
    {
      "source": "/api/promotions",
      "destination": "/api/admin/opinions?promotionsRoute=1"
    },
    {
      "source": "/api/podcast",
      "destination": "/api/admin/opinions?podcastRoute=1"
    },
    {
      "source": "/api/account/type",
      "destination": "/api/admin/opinions?accountTypeRoute=1"
    },
    {
      "source": "/api/artist/studio",
      "destination": "/api/admin/opinions?artistStudioRoute=1"
    },
    {
      "source": "/api/music/download",
      "destination": "/api/admin/opinions?downloadRoute=1"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/admin/opinions?authPath=$1"
    },
    {
      "source": "/control-room",
      "destination": "/"
    },
    {
      "source": "/control-room/:path*",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/editorial/auto-post",
      "schedule": "0 8 * * *"
    }
  ]
}
